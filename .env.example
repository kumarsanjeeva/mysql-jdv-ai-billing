# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

# --- MySQL admin connection (setup, schema DDL, running sql/*.sql scripts) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=jdv_billing

# --- Least-privilege user the AI agent connects as (JSON Duality Views only, no base-table grants) ---
AGENT_DB_USER=jdv_agent
AGENT_DB_PASSWORD=

# --- Anthropic Claude API (used by agent/agent.py; agent/scenarios.py runs without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
