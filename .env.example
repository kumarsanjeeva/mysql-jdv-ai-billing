# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.

# --- MySQL admin connection (setup, schema DDL, running sql/*.sql scripts) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=jdv_billing

# --- Least-privilege user the AI agent connects as (JSON Duality Views only, no base-table grants) ---
AGENT_DB_USER=jdv_agent
AGENT_DB_PASSWORD=

# --- Anthropic Claude API (used by agent/agent.py; agent/scenarios.py runs without it) ---
ANTHROPIC_API_KEY=
# --- Google Gemini API key (AI Studio), used when AGENT_PROVIDER=gemini ---
GEMINI_API_KEY=
# --- Which LLM the agent uses: AGENT_PROVIDER = anthropic | gemini; AGENT_MODEL = that provider's model id (no defaults) ---
AGENT_PROVIDER=
AGENT_MODEL=
# --- Prompt/tool-description version: v1 or v2 (required, no default; agent/agent.py exits if unset) ---
AGENT_PROMPT_VERSION=
# --- Optional (commented out; the defaults apply when unset): AGENT_TODAY = date in the system prompt (default 2026-09-26); AGENT_BUSINESS_ID = business the tools act for (default 1) ---
# AGENT_TODAY=
# AGENT_BUSINESS_ID=
